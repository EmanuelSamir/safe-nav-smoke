defaults:
  - env/simulator@simulator: smoke
  - env/sensors@sensor: global
  - env: smoke_env
  - agent: dubins
  - _self_

# Global settings
project_name: "default" # Change it depending what you are working on
seed: 42
debug: false

world_size: [35.0, 35.0]

# Hydra settings for output directory organization
hydra:
  run:
    dir: outputs/${project_name}/${now:%Y-%m-%d}/${now:%H-%M-%S}
  sweep:
    dir: outputs/${project_name}/multirun/${now:%Y-%m-%d}/${now:%H-%M-%S}
    subdir: ${hydra.job.num}
